# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# Generate a new SECRET_KEY for production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-me-in-production-generate-new-key

# Set to False in production!
DEBUG=False

# Set to 'production' for production environment
DJANGO_ENV=production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=api.theinfinitedebate.com,theinfinitedebate.com

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Docker Compose uses 'db' as hostname
DB_NAME=debates
DB_USER=debatesuser
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis & Celery Configuration
# -----------------------------------------------------------------------------
# Docker Compose uses 'redis' as hostname
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Anthropic API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------------------------------------
# Stripe Payment Configuration
# -----------------------------------------------------------------------------
# Production keys (starts with sk_live_ and pk_live_)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (get from Stripe Dashboard)
STRIPE_STUDENT_PRICE_ID=price_your_student_price_id
STRIPE_SCHOLAR_PRICE_ID=price_your_scholar_price_id

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://theinfinitedebate.com,https://www.theinfinitedebate.com

# -----------------------------------------------------------------------------
# Email Configuration (ICDSoft SMTP)
# -----------------------------------------------------------------------------
# Check ICDSoft documentation for exact SMTP server details
EMAIL_HOST=mail.icdsoft.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@theinfinitedebate.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=The Infinite Debate <noreply@theinfinitedebate.com>
SERVER_EMAIL=errors@theinfinitedebate.com

# -----------------------------------------------------------------------------
# Monitoring & Error Tracking (Sentry - Recommended for Production)
# -----------------------------------------------------------------------------
# Enable Sentry error tracking and performance monitoring
# Set to 'True' in production, 'False' in development
SENTRY_ENABLED=False

# Sentry DSN (Data Source Name)
# Get from: https://sentry.io/ after creating a project
# Format: https://<key>@<organization>.ingest.sentry.io/<project-id>
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Performance monitoring sample rate (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100% (can be expensive in production)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0 to 1.0)
# Profiles sampled transactions for performance insights
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Release tracking (use git commit hash or semantic version)
# Example: philosophical-debates@1.0.0 or git SHA
SENTRY_RELEASE=philosophical-debates@1.0.0

# -----------------------------------------------------------------------------
# Celery Flower Monitoring (Optional)
# -----------------------------------------------------------------------------
# Credentials for Flower web interface
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# AWS S3 Backup Configuration
# -----------------------------------------------------------------------------
# REQUIRED: S3 bucket for automated database backups
S3_BACKUP_BUCKET=philosophical-debates-backups

# AWS credentials for backup IAM user
# Create dedicated IAM user with S3 backup policy (see S3_AUTO_BACKUP_PLAN.md)
AWS_ACCESS_KEY_ID=AKIA_your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS region (should match your S3 bucket region)
AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Configuration (Optional - for S3 static files in future)
# -----------------------------------------------------------------------------
# AWS_STORAGE_BUCKET_NAME=your-static-files-bucket
# AWS_S3_REGION_NAME=us-east-1
