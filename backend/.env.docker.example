# =============================================================================
# DOCKER DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy this file to .env.docker and fill in your actual values
# NEVER commit .env.docker to version control!
# =============================================================================

# Django Core
SECRET_KEY=generate-a-new-secret-key-here
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# API Keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database (PostgreSQL) - Docker service names
DB_NAME=debates
DB_USER=debatesuser
DB_PASSWORD=your-dev-password-here
DB_HOST=db
DB_PORT=5432

# Redis & Celery - Docker service names
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Stripe Configuration (use test mode keys for development)
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-test-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Starter Tier Price IDs (TEST MODE)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_your_starter_monthly
STRIPE_STARTER_YEARLY_PRICE_ID=price_your_starter_yearly

# Pro Tier Price IDs (TEST MODE)
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly

# Sentry Error Tracking & Performance Monitoring
SENTRY_ENABLED=False
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_RELEASE=philosophical-debates@dev
